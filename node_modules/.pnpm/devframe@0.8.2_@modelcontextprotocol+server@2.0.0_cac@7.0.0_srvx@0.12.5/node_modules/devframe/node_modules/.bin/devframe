else
  export NODE_PATH="/Users/alyssalytle/Documents/455-slides/slidev/node_modules/.pnpm/devframe@0.8.2_@modelcontextprotocol+server@2.0.0_cac@7.0.0_srvx@0.12.5/node_modules/devframe/node_modules:/Users/alyssalytle/Documents/455-slides/slidev/node_modules/.pnpm/devframe@0.8.2_@modelcontextprotocol+server@2.0.0_cac@7.0.0_srvx@0.12.5/node_modules:/Users/alyssalytle/Documents/455-slides/slidev/node_modules/.pnpm/node_modules:$NODE_PATH"
